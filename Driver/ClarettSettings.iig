#ifndef ClarettSettings_h
#define ClarettSettings_h
#include <AudioDriverKit/IOUserAudioCustomProperty.iig>
using namespace AudioDriverKit;
class ClarettAudio;
class ClarettSettings : public IOUserAudioCustomProperty {
public:
    bool Configure(ClarettAudio *owner, bool timing = false) LOCALONLY;
